{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "aws-sam",
            "request": "direct-invoke",
            "name": "SCI: API Gateway",
            "invokeTarget": {
                "target": "api",
                "templatePath": "${workspaceFolder}/template.yaml",
                "logicalId": "SciBackend"
            },
            "api": {
                "path": "/data",
                "httpMethod": "post",
                "payload": {
                    "path" : "${workspaceFolder}/tests/payloads/post_payload.json"
                }
            }
        },
        {
            "type": "aws-sam",
            "request": "direct-invoke",
            "name": "Invoke Lambda via Template",
            "invokeTarget": {
                "target": "template",
                "templatePath": "${workspaceFolder}/template.yaml",
                "logicalId": "PACEBackend"
            },
            "lambda": {
                "payload": {
                    "path" : "${workspaceFolder}/tests/payloads/api_payload.json"
                }
            }
        }
    ]
}